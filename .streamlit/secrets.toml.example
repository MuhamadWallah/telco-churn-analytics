# Copy this file to  .streamlit/secrets.toml  (same folder) and fill in the
# password you typed for the churn_dashboard role when you ran
# sql/09_dashboard_access.sql. Never share secrets.toml or put it in Git.
#
# The dashboard connects with this LOW-PRIVILEGE role, never as postgres.

[postgres]
host = "localhost"
port = 5432
dbname = "telco_churn_dw"
user = "churn_dashboard"
password = "PUT-THE-CHURN_DASHBOARD-PASSWORD-HERE"
