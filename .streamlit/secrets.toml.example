# Copy this file to  .streamlit/secrets.toml  (same folder) and fill in the
# real values. Never share secrets.toml or put it in Git (.gitignore blocks it).
#
# [neon]      the public web app (app/streamlit_app.py). Use the READ-ONLY role
#             churn_app_reader from sql/11_app_reader_role.sql, never the owner.
#             On Streamlit Community Cloud paste the same [neon] lines into
#             App settings > Secrets.
# [postgres]  the local dashboard (dashboard/app.py), role churn_dashboard
#             from sql/09_dashboard_access.sql.

[neon]
url = "postgresql://churn_app_reader:PUT-THE-PASSWORD-HERE@ep-example-123456.us-east-2.aws.neon.tech/telco_churn_dw?sslmode=require&channel_binding=require"

[postgres]
host = "localhost"
port = 5432
dbname = "telco_churn_dw"
user = "churn_dashboard"
password = "PUT-THE-CHURN_DASHBOARD-PASSWORD-HERE"
